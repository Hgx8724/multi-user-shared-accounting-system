@startuml
' 结构性图（必画）：领域类及其关系
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 45
skinparam ranksep 55
skinparam linetype ortho
hide empty members

title UML类图：在线多人记账系统领域模型

package "身份与账本模块" {
  class "用户账号\nUserAccount" as UserAccount {
    - id: UUID
    - username: String
    - credentialHash: String
    - status: AccountStatus
    + authenticate(rawPassword: String): Boolean
    + bindAuthMethod(binding: AuthBinding): void
  }

  class "认证绑定\nAuthBinding" as AuthBinding {
    - id: UUID
    - authType: String
    - externalSubject: String
    - userId: UUID
  }

  class "账本\nLedger" as Ledger {
    - id: UUID
    - name: String
    - ownerId: UUID
    - status: LedgerStatus
    - roundingCursor: Long
    - createdAt: DateTime
  }

  class "账本成员\nLedgerMembership" as LedgerMembership {
    - id: UUID
    - ledgerId: UUID
    - userId: UUID
    - status: MembershipStatus
    + isActive(): Boolean
    + can(action: ActionType): Boolean
  }

  class "成员有效期\nMembershipPeriod" as MembershipPeriod {
    - id: UUID
    - membershipId: UUID
    - role: LedgerRole
    - joinedAt: DateTime
    - leftAt: DateTime
    - status: PeriodStatus
    + isActive(): Boolean
  }

  enum "成员状态\nMembershipStatus" as MembershipStatus {
    ACTIVE
    INACTIVE
  }

  enum "有效期状态\nPeriodStatus" as PeriodStatus {
    ACTIVE
    ENDED
  }

  enum "账本状态\nLedgerStatus" as LedgerStatus {
    ACTIVE
    ARCHIVED
  }

  enum "账本角色\nLedgerRole" as LedgerRole {
    OWNER
    ADMIN
    MEMBER
    VIEWER
  }
}

package "账目与审批模块" {
  class "账目\nExpenseEntry" as ExpenseEntry {
    - id: UUID
    - ledgerId: UUID
    - creatorMembershipId: UUID
    - purpose: String
    - occurredAt: DateTime
    - category: PresetCategory
    - amount: Decimal
    - remark: String
    - status: EntryStatus
    - lastModifiedAt: DateTime
    - correctionOfEntryId: UUID
    - version: Long
  }

  class "实际付款\nExpensePayment" as ExpensePayment {
    - id: UUID
    - entryId: UUID
    - payerMembershipId: UUID
    - amount: Decimal
    - paidAt: DateTime
  }

  enum "账目状态\nEntryStatus" as EntryStatus {
    DRAFT
    PENDING
    ACTIVE
    SETTLED
    REJECTED
    REVOKED
  }

  class "审批申请\nApprovalRequest" as ApprovalRequest {
    - id: UUID
    - entryId: UUID
    - applicantMembershipId: UUID
    - requestType: RequestType
    - payloadSnapshot: Json
    - status: ApprovalStatus
    - submittedAt: DateTime
    - reviewedAt: DateTime
  }

  class "账目修改记录\nChangeRecord" as ChangeRecord {
    - id: UUID
    - entryId: UUID
    - changeNo: Long
    - operatorUserId: UUID
    - changedAt: DateTime
    - beforeSnapshot: Json
    - afterSnapshot: Json
  }

  class "免审规则\nExemptionRule" as ExemptionRule {
    - id: UUID
    - ledgerId: UUID
    - targetEntryId: UUID
    - targetField: String
    - targetAction: ActionType
    - enabled: Boolean
  }

  enum "分摊方式\nSplitMethod" as SplitMethod {
    AVERAGE
    MANUAL
  }

  class "分摊请求\nSplitRequest" as SplitRequest {
    - totalAmount: Decimal
    - participantIds: List<UUID>
    - manualAmounts: Map<UUID, Decimal>
  }

  class "分摊方案\nExpenseSplitPlan" as ExpenseSplitPlan {
    - id: UUID
    - entryId: UUID
    - strategyType: SplitMethod
    - participantCount: Int
    - roundingCursorBefore: Long
    - roundingCursorAfter: Long
    - createdAt: DateTime
  }

  class "轮转公平状态\nRoundingAllocationState" as RoundingAllocationState {
    - ledgerId: UUID
    - membershipId: UUID
    - numerator: BigInt
    - denominator: BigInt
    - version: Long
    - updatedAt: DateTime
    + addEntitlement(numerator: BigInt, denominator: BigInt): void
    + consumeOneCent(): void
  }

  class "分摊明细\nSplitShare" as SplitShare {
    - id: UUID
    - planId: UUID
    - membershipId: UUID
    - roundingAdjustmentCents: Int
    - amount: Decimal
  }

  interface "分摊策略\nSplitStrategy" as SplitStrategy {
    + split(request: SplitRequest): List<SplitShare>
  }

  class "平均分摊策略\nAverageSplitStrategy" as AverageSplitStrategy {
    + split(request): List<SplitShare>
  }

  class "手工分摊策略\nManualSplitStrategy" as ManualSplitStrategy {
    + split(request): List<SplitShare>
  }
}

package "结算模块" {
  class "结算报告\nSettlementReport" as SettlementReport {
    - id: UUID
    - ledgerId: UUID
    - generatedBy: UUID
    - generatedAt: DateTime
    - totalAmount: Decimal
    - status: ReportStatus
  }

  class "结算明细\nSettlementLine" as SettlementLine {
    - id: UUID
    - reportId: UUID
    - membershipSnapshotId: UUID
    - displayName: String
    - shareTotalAmount: Decimal
    - netAmount: Decimal
    - currency: String
  }

  class "结算付款指令\nSettlementTransfer" as SettlementTransfer {
    - id: UUID
    - reportId: UUID
    - debtorMembershipId: UUID
    - creditorMembershipId: UUID
    - amount: Decimal
    - status: TransferStatus
    - currency: String
  }

  enum "付款指令状态\nTransferStatus" as TransferStatus {
    OPEN
    MARKED_PAID_EXTERNALLY
    WRITTEN_OFF
  }

}

package "查询、审计与通知模块" {
  class "操作日志\nAuditLog" as AuditLog {
    - id: UUID
    - ledgerId: UUID
    - actorUserId: UUID
    - action: ActionType
    - targetType: String
    - targetId: UUID
    - result: String
    - createdAt: DateTime
  }

  class "应用内通知\nNotification" as Notification {
    - id: UUID
    - recipientUserId: UUID
    - entryId: UUID
    - type: NotificationType
    - content: String
    - readAt: DateTime
  }
}

' 身份与账本
UserAccount "1" -- "0..*" AuthBinding : 绑定认证方式 >
UserAccount "1" -- "0..*" Ledger : 所有 >
UserAccount "1" -- "0..*" LedgerMembership : 加入 >
Ledger "1" *-- "1..*" LedgerMembership : 包含 >
LedgerMembership "1" *-- "1..*" MembershipPeriod : 有效期 >
MembershipPeriod "0..*" --> "1" LedgerRole : 具有 >
Ledger "0..*" --> "1" LedgerStatus : 当前状态 >

' 账目、审批与分摊
Ledger "1" o-- "0..*" ExpenseEntry : 记录 >
LedgerMembership "1" -- "0..*" ExpenseEntry : 创建者 >
ExpenseEntry "1" *-- "1..*" ExpensePayment : 实际付款 >
ExpensePayment "0..*" --> "1" LedgerMembership : 付款成员 >
ExpenseEntry "1" -- "1" ExpenseSplitPlan : 分摊方案 >
ExpenseSplitPlan "1" *-- "1..*" SplitShare : 成员份额 >
ExpenseSplitPlan --> SplitMethod : 使用 >
ExpenseSplitPlan ..> SplitRequest : 构造 >
SplitStrategy ..> SplitRequest : 输入 >
ExpenseSplitPlan ..> SplitStrategy : 执行 >
ExpenseEntry "0..*" --> "1" EntryStatus : 当前状态 >
ExpenseEntry "1" *-- "0..*" ApprovalRequest : 对应申请 >
ExpenseEntry "1" *-- "0..*" ChangeRecord : 保留修改 >
SplitShare "0..*" --> "1" LedgerMembership : 分摊成员 >
SplitStrategy <|.. AverageSplitStrategy
SplitStrategy <|.. ManualSplitStrategy
Ledger "1" *-- "0..*" ExemptionRule : 配置 >
ExemptionRule "0..*" --> "0..1" ExpenseEntry : 可指定账目 >

' 结算
Ledger "1" -- "0..*" SettlementReport : 生成 >
Ledger "1" *-- "0..*" RoundingAllocationState : 公平分配状态 >
LedgerMembership "1" -- "0..*" RoundingAllocationState : 舍入应得额 >
SettlementReport "1" *-- "1..*" SettlementLine : 成员明细 >
SettlementReport "1" *-- "0..*" SettlementTransfer : 付款指令 >
SettlementTransfer "0..*" --> "1" LedgerMembership : 债务成员 >
SettlementTransfer "0..*" --> "1" LedgerMembership : 债权成员 >
SettlementTransfer "0..*" --> "1" TransferStatus : 当前状态 >

' 审计与通知
Ledger "1" *-- "0..*" AuditLog : 记录操作 >
UserAccount "1" -- "0..*" Notification : 接收 >
Notification "0..*" --> "0..1" ExpenseEntry : 关联账目 >

note bottom of RoundingAllocationState
  按稳定 LedgerMembership 保存，重新加入不重置；
  这不是货币余额，只记录累计舍入应得额；
  用精确分子/分母保存，所有成员应得额之和为零。
end note

note bottom of SettlementTransfer
  一条付款指令只连接一个债务成员关系和一个债权成员关系；
  默认状态为 OPEN，系统不自动确认到账；
  同一债务人或债权人可对应多条付款指令。
end note

@enduml
